# ---------------------------------------------------------------------------
# Makefile — se copie tel quel, il n'y a rien à y renseigner.
#
# Les commandes viennent du dépôt makefile-templates, branché en .make/.
# ---------------------------------------------------------------------------

# « make » sans argument liste les commandes (cible .list, tout en bas). À poser
# ici, avant le moindre include : make renseigne .DEFAULT_GOAL de lui-même dès
# la première cible qu'il rencontre, et ne touche plus à une valeur déjà là —
# c'est ce qui laisse un local.mk imposer la sienne.
.DEFAULT_GOAL := .list

# Tous les fragments présents dans .make/, sans avoir à les nommer un par un.
include $(wildcard .make/*/*.mk)

# Tout ce qui est propre au projet se met sous cet include — ici même, ou dans
# un local.mk à la racine s'il existe :
#   - une cible : déclarée en .PHONY, elle apparaîtra dans la liste ;
#   - une valeur, EXEC en particulier, qui l'emporte alors sur celle du
#     fragment (EXEC := ./vendor/bin/sail, ou vide pour sortir de Docker).
-include local.mk

# ---------------------------------------------------------------------------
# « make » sans argument liste les commandes, lues dans les .PHONY
# ---------------------------------------------------------------------------
.PHONY: .list

.list:
	@printf '\n  \033[1;35m%s\033[0m — commandes disponibles\n' "$(notdir $(CURDIR))"
	@grep -h '^\.PHONY:' $(MAKEFILE_LIST) \
		| sed 's/^\.PHONY: *//' | tr ' ' '\n' | grep '@' | sort -u \
		| awk -F'@' '{ \
			if ($$1 != last) { printf "\n  \033[1;33m%s\033[0m\n", $$1; last = $$1 } \
			printf "    \033[36m%s\033[0m\n", $$0 \
		}'
	@printf '\n'
